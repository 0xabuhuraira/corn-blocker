{
  "manifest_version": 3,
  "name": "Corn Blocker",
  "version": "1.0.0",
  "description": "Corn Blocker keeps your browsing wholesome: blocks adult sites and searches, in every search engine and the address bar.",
  "browser_specific_settings": {
    "gecko": {
      "id": "corn-blocker@corn-blocker.addon",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["webNavigation", "webRequest", "webRequestBlocking", "storage", "unlimitedStorage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["blocked.html", "blocked.css", "blocked.js"], "matches": ["<all_urls>"] }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Corn Blocker settings" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
